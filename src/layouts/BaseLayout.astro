---
import "../styles/global.css";
import SiteIndex from "../components/SiteIndex.astro";

const { title = "corb.cc" } = Astro.props;
const currentPath = Astro.url.pathname;

const topNavItems = [
  { href: "/films", label: "films" },
  { href: "/photos", label: "photos" },
  { href: "/under-construction", label: "things" },
  { href: "/stuff", label: "stuff" },
  { href: "/archive", label: "archive" },
  { href: "/play", label: "play" },
  { href: "/about", label: "about" },
  { href: "/contact", label: "contact" }
];

const isCurrentSection = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body>
    <main class="page-shell">
      <header class="site-header">
        <div class="masthead">
          <div class="masthead-left">
            <span class="tiny-box">◻</span>
            <span class="tiny-box">✉</span>
            <span class="tiny-note">having fun on the computer</span>
          </div>

          <div class="site-mark">
            <a href="/">corb.cc</a>
          </div>

          <div class="masthead-right" aria-hidden="true"></div>
        </div>

        <div class="rule"></div>

        <section class="top-strip">
          <p class="stamp">daily updates; occasionally.</p>

          <nav class="top-nav" aria-label="Primary">
            {topNavItems.map((item) => (
              <a
                href={item.href}
                class={`wave-hover ${isCurrentSection(item.href) ? "is-active" : ""}`}
                aria-current={isCurrentSection(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <SiteIndex />
        </section>

        <div class="rule dashed"></div>
      </header>

      <slot />
    </main>

    <script>
      document.querySelectorAll(".wave-hover").forEach((el) => {
        if (el.dataset.waveReady === "true") return;

        const text = el.textContent ?? "";
        el.textContent = "";
        el.dataset.waveReady = "true";

        [...text].forEach((char, i) => {
          const span = document.createElement("span");
          span.textContent = char === " " ? "\u00A0" : char;
          span.style.setProperty("--i", i);
          el.appendChild(span);
        });

        el.addEventListener("mouseenter", () => {
          el.querySelectorAll("span").forEach((span) => {
            span.classList.remove("is-settling");
            span.style.transform = "";
          });

          el.classList.add("is-waving");
        });

        el.addEventListener("mouseleave", () => {
          const spans = el.querySelectorAll("span");

          spans.forEach((span) => {
            const computed = window.getComputedStyle(span).transform;

            span.classList.remove("is-settling");

            if (computed && computed !== "none") {
              span.style.transform = computed;
            } else {
              span.style.transform = "translateY(0)";
            }
          });

          el.classList.remove("is-waving");

          requestAnimationFrame(() => {
            spans.forEach((span) => {
              span.classList.add("is-settling");
              span.style.transform = "translateY(0)";
            });
          });
        });
      });
    </script>
  </body>
</html>
