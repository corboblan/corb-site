---
import { execFileSync } from "node:child_process";

const images = import.meta.glob<string>(
  "/public/images/{photos,fine-arts}/*/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true, query: "?url", import: "default" }
);
const galleryPaths = ["public/images/photos", "public/images/fine-arts"];

function gitPaths(args: string[]) {
  try {
    return execFileSync("git", [...args, "--", ...galleryPaths], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"]
    }).split("\0").filter(Boolean);
  } catch {
    return [];
  }
}

// Checkout timestamps reset on deploy. Use the commits that introduced each image.
const paths = new Set([
  ...gitPaths(["ls-files", "--others", "--exclude-standard", "-z"]),
  ...gitPaths(["diff", "HEAD", "--diff-filter=A", "--name-only", "-z"]),
  ...gitPaths(["log", "--full-history", "--no-renames", "--diff-filter=A", "--name-only", "--format=", "-z"]),
  ...Object.keys(images).sort().map((path) => path.slice(1))
]);

const recentImages = [...paths]
  .filter((path) => images[`/${path}`])
  .slice(0, 12)
  .map((path) => {
    const [, , section, category] = path.split("/");
    return {
      src: images[`/${path}`],
      href: `/${section}/${category}`,
      label: category.replaceAll("-", " ")
    };
  });
---

{recentImages.length > 0 && (
  <section class="recent-images" aria-labelledby="recent-images-title">
    <div class="carousel-header">
      <h2 id="recent-images-title">Recent images</h2>
      {recentImages.length > 1 && (
        <div class="carousel-controls">
          <button type="button" data-previous aria-label="Previous image" disabled>←</button>
          <button type="button" data-next aria-label="Next image">→</button>
        </div>
      )}
    </div>
    <div class="carousel-track" tabindex="0" role="region" aria-label="Scrollable recent images">
      {recentImages.map(({ src, href, label }, index) => (
        <a href={href} aria-label={`Image ${index + 1} · View ${label} gallery`} class:list={["carousel-slide", { "is-leading": index === 0 }]}>
          <img src={src} alt="" loading={index === 0 ? "eager" : "lazy"} decoding="async" />
        </a>
      ))}
    </div>
  </section>
)}

<script>
  const track = document.querySelector<HTMLElement>(".carousel-track");
  const previous = document.querySelector<HTMLButtonElement>("[data-previous]");
  const next = document.querySelector<HTMLButtonElement>("[data-next]");

  if (track && previous && next) {
    const slides = [...track.querySelectorAll<HTMLElement>(".carousel-slide")];
    const distanceFromLeft = (slide: HTMLElement) =>
      slide.getBoundingClientRect().left - track.getBoundingClientRect().left;
    let leading = 0;

    const update = () => {
      leading = slides.reduce((closest, slide, index) =>
        Math.abs(distanceFromLeft(slide)) < Math.abs(distanceFromLeft(slides[closest]))
          ? index
          : closest, 0);
      slides.forEach((slide, index) => slide.classList.toggle("is-leading", index === leading));
      previous.disabled = leading === 0;
      next.disabled = leading === slides.length - 1;
    };

    const move = (direction: number) => {
      const target = slides[leading + direction];
      if (target) {
        track.scrollBy({
          left: distanceFromLeft(target),
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth"
        });
      }
    };

    previous.addEventListener("click", () => move(-1));
    next.addEventListener("click", () => move(1));
    track.addEventListener("scroll", update, { passive: true });
    new ResizeObserver(update).observe(track);
  }
</script>

<style>
  .recent-images {
    padding: 1.25rem 0 1.5rem;
  }

  .carousel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: normal;
  }

  .carousel-controls {
    display: flex;
    gap: 0.5rem;
  }

  button {
    width: 2.5rem;
    min-height: 2.5rem;
    border: 1px solid currentColor;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  button:enabled:hover {
    background: var(--invert);
    color: var(--bg);
  }

  button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .carousel-track {
    --slide-width: clamp(15rem, 48%, 36rem);
    --slide-gap: 0.85rem;
    display: flex;
    align-items: center;
    gap: var(--slide-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block: 0.25rem 0.65rem;
  }

  .carousel-track:has(.carousel-slide:nth-child(2))::after {
    content: "";
    flex: 0 0 max(0px, calc(100% - var(--slide-width) - var(--slide-gap)));
  }

  .carousel-slide {
    flex: 0 0 var(--slide-width);
    aspect-ratio: 4 / 3;
    scroll-snap-align: start;
  }

  .carousel-slide:focus-visible {
    outline-offset: -2px;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(0.82);
    transform-origin: left center;
    transition: transform 180ms ease;
  }

  .is-leading img {
    transform: scale(1);
  }

  @media (max-width: 640px) {
    .carousel-track {
      --slide-width: 80%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    img {
      transition: none;
    }
  }
</style>
