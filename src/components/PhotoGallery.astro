---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  title: string;
  photos: string[];
  intro: string;
  itemLabel?: string;
  emptyLabel?: string;
}

const {
  title,
  photos,
  intro,
  itemLabel = "photograph",
  emptyLabel = "Photos"
} = Astro.props;
---

<BaseLayout title={`${title} — corb.cc`}>
  <section class="page-intro">
    <div>
      <h1>{title}</h1>
      <p class="intro">{intro}</p>
    </div>

  </section>

  <div class="rule dashed"></div>

  {photos.length > 0 ? (
    <>
      <section class="hero-image-section">
        <img
          src={photos[0]}
          alt={`Featured ${title} ${itemLabel}`}
          class="hero-image"
        />
      </section>

      <div class="rule"></div>

      <section class="gallery-intro">
        <p class="section-label">selected images</p>
        <p>Not sorted by trip. Just the images that feel strongest together.</p>
      </section>

      <section class="gallery-grid">
        {photos.slice(1).map((photo, index) => (
          <figure class={`gallery-item ${index % 5 === 0 ? "wide" : ""}`}>
            <img
              src={photo}
              alt={`${title} ${itemLabel} ${index + 2}`}
              loading="lazy"
            />
          </figure>
        ))}
      </section>
    </>
  ) : (
    <section class="empty-gallery">
      <p class="section-label">selected images</p>
      <p>{emptyLabel} coming soon.</p>
    </section>
  )}
</BaseLayout>

<style>
  .page-intro {
    padding: 1.8rem 0 1.4rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.2rem, 8vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    font-weight: 500;
  }

  .intro {
    max-width: 38rem;
    margin: 1rem 0 0;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .hero-image-section {
    padding: 1.5rem 0;
  }

  .hero-image {
    display: block;
    width: 100%;
    max-height: 46rem;
    object-fit: cover;
    border: 1px solid rgba(36, 31, 27, 0.08);
  }

  .gallery-intro {
    padding: 1.2rem 0 0.4rem;
  }

  .gallery-intro p:last-child,
  .empty-gallery p:last-child {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
    max-width: 34rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1rem;
    padding: 1.2rem 0 2rem;
  }

  .gallery-item {
    grid-column: span 4;
    margin: 0;
  }

  .gallery-item.wide {
    grid-column: span 8;
  }

  .gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 34rem;
    object-fit: cover;
    border: 1px solid rgba(36, 31, 27, 0.08);
    background: transparent;
  }

  .empty-gallery {
    min-height: 20rem;
    padding: 1.5rem 0 2rem;
  }

  @media (max-width: 900px) {
    .gallery-item,
    .gallery-item.wide {
      grid-column: span 12;
    }

    .hero-image {
      max-height: 30rem;
    }

    .gallery-item img {
      max-height: none;
    }
  }

  @media (max-width: 640px) {
    h1 {
      font-size: clamp(2.8rem, 13vw, 4.5rem);
    }

    .gallery-grid {
      gap: 0.8rem;
    }

    .hero-image {
      max-height: 22rem;
    }
  }
</style>
