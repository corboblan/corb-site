---
import BaseLayout from "../layouts/BaseLayout.astro";

const archiveCards = [
  {
    href: "/under-construction",
    title: "currently",
    description: "what i’m making, thinking about, or stuck on lately",
    size: "large"
  },
  {
    href: "/under-construction",
    title: "watching",
    description: "everything from films to weird youtube rabbit holes",
    size: "medium"
  },
  {
    href: "/under-construction",
    title: "playing",
    description: "stuff i’m playing through, revisiting, or thinking about",
    size: "medium"
  },
  {
    href: "/under-construction",
    title: "reading",
    description: "books, articles, and things i keep meaning to finish",
    size: "small"
  },
  {
    href: "/under-construction",
    title: "pokemon team",
    description: "for the people demanding to know the lineup",
    size: "small"
  },
  {
    href: "/archive/favorite-videos",
    title: "favorite videos",
    description: "videos i love, revisit, or keep recommending",
    size: "medium"
  },
  {
    href: "/under-construction",
    title: "thinking about",
    description: "things that keep floating around in my head",
    size: "large"
  }
];
---

<BaseLayout title="archive — corb.cc">
  <section class="page-intro">
    <div>
      <h1>a peek inside my brain</h1>
      <p class="intro">
        media i love, games i’m playing, things i’m thinking about, and
        whatever else ends up living here.
      </p>
    </div>

  </section>

  <div class="rule dashed"></div>

  <section class="archive-collage">
    {archiveCards.map((card) => (
      <a
        href={card.href}
        class={`archive-card ${card.size}`}
      >
        <span class="arrow">↗</span>

        <div class="card-body">
          <h2>{card.title}</h2>
          <p>{card.description}</p>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding: 1.8rem 0 1.4rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.2rem, 8vw, 6.2rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    font-weight: 500;
    max-width: 10ch;
  }

  .intro {
    max-width: 38rem;
    margin: 1rem 0 0;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .archive-collage {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.2rem;
    padding-top: 1.6rem;
  }

  .archive-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 14rem;
    padding: 1rem;
    border: 1px solid rgba(36, 31, 27, 0.1);
    background: transparent;
    transition:
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
    color: inherit;
    text-decoration: none;
  }

  .archive-card.large {
    grid-column: span 6;
  }

  .archive-card.medium {
    grid-column: span 4;
  }

  .archive-card.small {
    grid-column: span 3;
  }

  .arrow {
    align-self: flex-end;
    font-size: 1.1rem;
    transition: color 180ms ease;
  }

  .card-body h2 {
    margin: 1.8rem 0 0.55rem;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-weight: 500;
    max-width: 12ch;
  }

  .card-body p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
    max-width: 28ch;
    transition: color 180ms ease;
  }

  .archive-card:hover {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .archive-card:hover .card-body p {
    color: var(--bg);
  }

  @media (max-width: 1100px) {
    .archive-card.large,
    .archive-card.medium {
      grid-column: span 6;
    }

    .archive-card.small {
      grid-column: span 4;
    }
  }

  @media (max-width: 900px) {
    .archive-card.large,
    .archive-card.medium,
    .archive-card.small {
      grid-column: span 12;
    }
  }

  @media (max-width: 640px) {
    h1 {
      font-size: clamp(2.8rem, 13vw, 4.5rem);
    }

    .archive-card {
      min-height: 11rem;
    }
  }
</style>
