---
import BaseLayout from "../../layouts/BaseLayout.astro";

const images = import.meta.glob(
  "/public/images/photos/climbing/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  {
    eager: true,
    query: "?url",
    import: "default"
  }
);

const climbingPhotos = Object.entries(images)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, url]) => url);
---

<BaseLayout title="climbing — corb.cc">
  <section class="page-intro">
    <div>
      <h1>climbing</h1>
      <p class="intro">
        Movement, texture, effort, and the quiet space around all of it.
        A curated selection of climbing photographs.
      </p>
    </div>

  </section>

  <div class="rule dashed"></div>

  <section class="hero-image-section">
    <img
      src={climbingPhotos[0]}
      alt="Featured climbing photograph"
      class="hero-image"
    />
  </section>

  <div class="rule"></div>

  <section class="gallery-intro">
    <p class="section-label">selected images</p>
    <p>
      Not sorted by trip. Just the images that feel strongest together.
    </p>
  </section>

  <section class="gallery-grid">
    {climbingPhotos.slice(1).map((photo, index) => (
      <figure class={`gallery-item ${index % 5 === 0 ? "wide" : ""}`}>
        <img
          src={photo}
          alt={`Climbing photograph ${index + 2}`}
          loading="lazy"
        />
      </figure>
    ))}
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding: 1.8rem 0 1.4rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.2rem, 8vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    font-weight: 500;
  }

  .intro {
    max-width: 38rem;
    margin: 1rem 0 0;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .hero-image-section {
    padding: 1.5rem 0;
  }

  .hero-image {
    display: block;
    width: 100%;
    max-height: 46rem;
    object-fit: cover;
    border: 1px solid rgba(36, 31, 27, 0.08);
  }

  .gallery-intro {
    padding: 1.2rem 0 0.4rem;
  }

  .gallery-intro p:last-child {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
    max-width: 34rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1rem;
    padding: 1.2rem 0 2rem;
  }

  .gallery-item {
    grid-column: span 4;
    margin: 0;
  }

  .gallery-item.wide {
    grid-column: span 8;
  }

  .gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 34rem;
    object-fit: cover;
    border: 1px solid rgba(36, 31, 27, 0.08);
    background: transparent;
  }

  @media (max-width: 900px) {
    .gallery-item,
    .gallery-item.wide {
      grid-column: span 12;
    }

    .hero-image {
      max-height: 30rem;
    }

    .gallery-item img {
      max-height: none;
    }
  }

  @media (max-width: 640px) {
    h1 {
      font-size: clamp(2.8rem, 13vw, 4.5rem);
    }

    .gallery-grid {
      gap: 0.8rem;
    }

    .hero-image {
      max-height: 22rem;
    }
  }
</style>
