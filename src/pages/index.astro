---
import BaseLayout from "../layouts/BaseLayout.astro";
import RecentImages from "../components/RecentImages.astro";

const floatingBits = [
  { text: "✦", top: "7%", left: "6%", color: "var(--red)", size: "1rem", rotate: "-12deg" },
  { text: "◌", top: "10%", right: "9%", color: "var(--text)", size: "0.95rem", rotate: "9deg" },
  { text: "⌂", top: "21%", right: "14%", color: "var(--green)", size: "1rem", rotate: "0deg" },
  { text: "⌁", top: "58%", left: "4%", color: "var(--brown)", size: "1rem", rotate: "8deg" },
  { text: "◢", top: "74%", right: "11%", color: "var(--red)", size: "0.9rem", rotate: "-10deg" }
];
---

<BaseLayout title="corb.cc">
  {floatingBits.map((bit) => (
    <span
      class="floating-bit"
      style={`
        top:${bit.top};
        left:${bit.left ?? "auto"};
        right:${bit.right ?? "auto"};
        color:${bit.color};
        font-size:${bit.size};
        transform: rotate(${bit.rotate});
      `}
      aria-hidden="true"
    >
      {bit.text}
    </span>
  ))}

  <section class="hero">
    <div class="hero-copy">
      <h1>
        a place
        <br />
        for
        <span class="accent-red pixel-all-wave" aria-label="all">
          <span>a</span><span>l</span><span>l</span>
        </span>
        <br />
        of my <span class="accent-blue">art</span>
      </h1>

      <p class="intro">
        art, photographs, films, restored objects, writings, experiments,
        illustrations and other stuff I want to keep online.
      </p>
    </div>

    <div class="hero-card">
      <div class="photo-wrap">
        <img
          src="/images/homepage_photo.jpg"
          alt="Featured image from corb.cc"
          class="homepage_photo"
        />
      </div>

      <p class="card-caption">self portrait - gameboy camera - 0.02 megapixels</p>
    </div>
  </section>

  <div class="rule"></div>

  <RecentImages />

  <div class="rule dashed"></div>

  <footer class="footer">
    <p>corb.cc — issue zero</p>
  </footer>
</BaseLayout>

<style>
  .floating-bit {
    position: absolute;
    line-height: 1;
    opacity: 0.72;
    user-select: none;
    pointer-events: none;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.95fr;
    gap: 2.2rem;
    align-items: center;
    padding: 2rem 0 1.6rem;
  }

  .hero-copy {
    padding-right: 1rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(4rem, 10vw, 8.5rem);
    line-height: 0.88;
    letter-spacing: -0.065em;
    font-weight: 500;
  }

  .accent-red {
    color: var(--red);
  }

  .accent-blue {
    color: var(--blue);
  }

  .intro {
    max-width: 34rem;
    margin: 1.25rem 0 0;
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .hero-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .photo-wrap {
    background: transparent;
    border: none;
    padding: 0;
  }

  .homepage_photo {
    display: block;
    width: 100%;
    height: 26rem;
    object-fit: cover;
    border: 1px solid rgba(36, 31, 27, 0.08);
  }

  .card-caption {
    margin: 0.6rem 0 0;
    color: var(--soft);
    font-size: 0.88rem;
  }

  .footer {
    padding-top: 1rem;
    color: var(--soft);
    font-size: 0.9rem;
  }

  .footer p {
    margin: 0;
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      padding-right: 0;
    }

    .homepage_photo {
      height: 22rem;
    }
  }

  @media (max-width: 640px) {
    .hero {
      gap: 1.4rem;
      padding: 1.5rem 0 1.25rem;
    }

    h1 {
      font-size: clamp(3rem, 14vw, 4.6rem);
      line-height: 0.92;
    }

    .intro {
      font-size: 1rem;
      line-height: 1.65;
      margin-top: 1rem;
    }

    .homepage_photo {
      height: auto;
    }

    .card-caption {
      margin-top: 0.5rem;
      font-size: 0.84rem;
    }

    .footer {
      font-size: 0.82rem;
    }

    .floating-bit {
      opacity: 0.25;
    }
  }
</style>
