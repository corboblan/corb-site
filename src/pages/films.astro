---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    title: "Crash Out",
    type: "short film",
    description: "An awarding-winning short film about pursuing the things that bring you joy, especially through heartbreak.",
    year: "2025",
    color: "var(--blue)",
    href: "https://youtu.be/C26oBHtdNnM",
    image: "/images/films/crash-out.jpg"
  },

  {
    title: "The Idea of Us",
    type: "short film",
    description: "A visual letter written across sixteen days in Europe.",
    year: "2025",
    color: "var(--red)",
    href: "https://www.youtube.com/watch?v=cCcpVtYgt04&t=14s",
    image: "/images/films/gameboy.jpg"
  }
];
---

<BaseLayout title="films — corb.cc">
  <section class="page-intro">
    <div>
      <h1>films</h1>
      <p class="intro">
        short films and video experiments. some finished, some still becoming.
      </p>
    </div>

  </section>

  <div class="rule dashed"></div>

  <section class="projects">
    {projects.map((project) => (
      <a
        href={project.href}
        class="project-link"
        target={project.href.startsWith("http") ? "_blank" : undefined}
        rel={project.href.startsWith("http") ? "noreferrer" : undefined}
      >
        <div class="project">
          <div class="project-thumb">
            <img src={project.image} alt={project.title} />
          </div>

          <div class="project-info">
            <div class="project-top">
              <h2 style={`color:${project.color}`}>{project.title}</h2>
              <span class="year">{project.year}</span>
            </div>

            <p class="type">{project.type}</p>
            <p class="description">{project.description}</p>
          </div>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding: 1.8rem 0 1.4rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    font-weight: 500;
  }

  .intro {
    max-width: 38rem;
    margin: 1rem 0 0;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .projects {
    display: grid;
    gap: 2.2rem;
    padding: 1.6rem 0;
  }

  .project-link {
    text-decoration: none;
    color: inherit;
  }

  .project {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2rem;
    align-items: center;
  }

  /* 🔥 FIXED THUMBNAIL SYSTEM */
  .project-thumb {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(36, 31, 27, 0.08);
    border-radius: 0.85rem;
    background: transparent;
    aspect-ratio: 4 / 5;
  }

  .project-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .project-link:hover .project-thumb img {
    transform: scale(1.03);
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  h2 {
    margin: 0;
    font-size: 1.8rem;
    letter-spacing: -0.02em;
  }

  .year {
    font-size: 0.9rem;
    color: var(--soft);
  }

  .type {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .description {
    margin: 0.4rem 0 0;
    color: var(--muted);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .project {
      grid-template-columns: 1fr;
    }
  }
</style>
