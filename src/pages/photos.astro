---
import BaseLayout from "../layouts/BaseLayout.astro";

const portraitImages = import.meta.glob(
  "/public/images/photos/portraits/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true, query: "?url", import: "default" }
);

const travelImages = import.meta.glob(
  "/public/images/photos/travel/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true, query: "?url", import: "default" }
);

const firstImage = (images: Record<string, unknown>) =>
  Object.entries(images)
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(([, url]) => url)[0] as string | undefined;

const photoSets = [
  {
    title: "Wedding Work",
    image: "/images/photos/wedding-work.jpg",
    href: "/photos/engagements"
  },
  {
    title: "Portraits",
    image: firstImage(portraitImages),
    href: "/photos/portraits"
  },
  {
    title: "Travel / Places",
    image: firstImage(travelImages),
    href: "/photos/travel"
  },
  {
    title: "Climbing",
    image: "/images/photos/climbing.jpg",
    href: "/photos/climbing"
  }
];
---

<BaseLayout title="photos — corb.cc">
  <section class="page-intro">
    <div>
      <h1>people, places, weddings, and everything else</h1>
      <p class="intro">
        Probably the deepest part of my work. Client work, personal images,
        travel, climbing, portraits, and other photos I want to keep close.
      </p>
    </div>

  </section>

  <div class="rule dashed"></div>

  <section class="photos-grid">
    {photoSets.map((set) => (
      <article class="photo-card">
        <a href={set.href} target="_blank" rel="noreferrer" class="photo-link">
          <div class="image-wrap">
            {set.image ? (
              <img src={set.image} alt={set.title} class="set-image" />
            ) : (
              <div class="set-image set-placeholder">photos coming soon</div>
            )}
          </div>

          <div class="set-info">
            <h2>{set.title}</h2>
          </div>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding: 1.8rem 0 1.4rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.2rem, 8vw, 6.4rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    font-weight: 500;
    max-width: 12ch;
  }

  .intro {
    max-width: 40rem;
    margin: 1rem 0 0;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .photos-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem 1.5rem;
    padding-top: 1.6rem;
  }

  .photo-card {
    min-width: 0;
  }

  .photo-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .image-wrap {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(36, 31, 27, 0.08);
    border-radius: 0.85rem;
    background: transparent;
  }

  .set-image {
    display: block;
    width: 100%;
    height: 24rem;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .set-placeholder {
    display: grid;
    place-items: center;
    color: var(--soft);
    font-size: 0.9rem;
    font-style: italic;
  }

  .set-info {
    padding-top: 0.85rem;
  }

  .set-info h2 {
    margin: 0;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .photo-link:hover .set-image {
    transform: scale(1.02);
  }

  .photo-link:hover .set-info h2 {
    color: var(--blue);
  }

  @media (max-width: 900px) {
    .photos-grid {
      grid-template-columns: 1fr;
    }

    .set-image {
      height: 20rem;
    }
  }

  @media (max-width: 640px) {
    h1 {
      font-size: clamp(2.8rem, 13vw, 4.5rem);
    }

    .set-image {
      height: 16rem;
    }

  }
</style>
