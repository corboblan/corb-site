---
import BaseLayout from "../layouts/BaseLayout.astro";

const illustrationImages = import.meta.glob(
  "/public/images/fine-arts/illustration/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true, query: "?url", import: "default" }
);

const paintingImages = import.meta.glob(
  "/public/images/fine-arts/paintings/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true, query: "?url", import: "default" }
);

const artisticPhotoImages = import.meta.glob(
  "/public/images/fine-arts/artistic-photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true, query: "?url", import: "default" }
);

const firstImage = (images: Record<string, unknown>) =>
  Object.entries(images)
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(([, url]) => url)[0] as string | undefined;

const artSets = [
  {
    title: "Illustration",
    image: firstImage(illustrationImages),
    href: "/fine-arts/illustration"
  },
  {
    title: "Paintings",
    image: firstImage(paintingImages),
    href: "/fine-arts/paintings"
  },
  {
    title: "Artistic Photos",
    image: firstImage(artisticPhotoImages),
    href: "/fine-arts/artistic-photos"
  }
];
---

<BaseLayout title="fine arts — corb.cc">
  <section class="page-intro">
    <h1>drawings, paintings, photographs, and other things made by hand</h1>
    <p class="intro">
      A place for visual work that lives outside of client projects. Finished
      pieces, experiments, studies, and ideas worth keeping around.
    </p>
  </section>

  <div class="rule dashed"></div>

  <section class="art-grid">
    {artSets.map((set) => (
      <article class="art-card">
        <a href={set.href} class="art-link">
          <div class="image-wrap">
            {set.image ? (
              <img src={set.image} alt={set.title} class="set-image" />
            ) : (
              <div class="set-image set-placeholder">art coming soon</div>
            )}
          </div>

          <div class="set-info">
            <h2>{set.title}</h2>
          </div>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding: 1.8rem 0 1.4rem;
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(3.2rem, 8vw, 6.4rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    font-weight: 500;
  }

  .intro {
    max-width: 40rem;
    margin: 1rem 0 0;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .art-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem 1.5rem;
    padding-top: 1.6rem;
  }

  .art-card {
    min-width: 0;
  }

  .art-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .image-wrap {
    overflow: hidden;
    border: 1px solid rgba(36, 31, 27, 0.08);
    border-radius: 0.85rem;
    background: transparent;
  }

  .set-image {
    display: block;
    width: 100%;
    height: 24rem;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .set-placeholder {
    display: grid;
    place-items: center;
    color: var(--soft);
    font-size: 0.9rem;
    font-style: italic;
  }

  .set-info {
    padding-top: 0.85rem;
  }

  .set-info h2 {
    margin: 0;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .art-link:hover .set-image {
    transform: scale(1.02);
  }

  .art-link:hover h2 {
    color: var(--blue);
  }

  @media (max-width: 900px) {
    .art-grid {
      grid-template-columns: 1fr;
    }

    .set-image {
      height: 20rem;
    }
  }

  @media (max-width: 640px) {
    h1 {
      font-size: clamp(2.8rem, 13vw, 4.5rem);
    }

    .set-image {
      height: 16rem;
    }
  }
</style>
