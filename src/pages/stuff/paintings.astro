---
import PhotoGallery from "../../components/PhotoGallery.astro";

const images = import.meta.glob(
  "/public/images/stuff/paintings/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true, query: "?url", import: "default" }
);

const artworks = Object.entries(images)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, url]) => url);
---

<PhotoGallery
  title="paintings"
  photos={artworks}
  intro="Paintings, color studies, and work made by hand."
  itemLabel="painting"
  emptyLabel="Paintings"
/>
